{
  "name": "mural-de-notas-backend",
  "version": "1.0.0",
  "description": "API do Mural de Notas (Express + SQLite)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node scripts/seed-demo.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
