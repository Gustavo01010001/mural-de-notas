# Copie para .env.local se precisar mudar.

# Onde está o backend. O navegador acessa o front por HTTPS e o Next repassa /api/* para cá,
# dentro do próprio PC (por isso aqui é http e 127.0.0.1: essa conexão não sai da máquina).
BACKEND_URL=http://127.0.0.1:4000

# Opcional: chamar a API direto, sem passar pelo Next (ex.: backend publicado em outro domínio)
# NEXT_PUBLIC_API_URL=https://minha-api.com/api
