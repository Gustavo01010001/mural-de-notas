# Copie este arquivo para .env e ajuste se precisar
PORT=4000
# 127.0.0.1 = só o próprio PC (o front em HTTPS repassa /api para cá). 0.0.0.0 = expor a API na rede.
HOST=127.0.0.1
# Endereço do front (o navegador acessa por HTTPS)
FRONT_URL=https://localhost:3000

# Opcional: chave da Google Weather API (Google Maps Platform).
# Sem ela, o clima vem da Open-Meteo (gratuita, sem cadastro).
GOOGLE_WEATHER_API_KEY=
